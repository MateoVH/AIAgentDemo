@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResource> L
@inject IChatClientProvider Provider

<header class="topbar">
    <a class="brand" href="">
        <BrandMark />
        <span class="brand-store">@L["Brand_Store"]</span>
        <span class="brand-product">@L["Brand_Product"]</span>
    </a>

    <span class="provider @(Provider.IsSimulated ? "is-demo" : "is-live")">
        <span class="provider-dot" aria-hidden="true"></span>
        @(Provider.IsSimulated
            ? L["Provider_Demo"]
            : L["Provider_Live", Provider.Kind, Provider.GetProfile(AgentRole.Supervisor).Model])
    </span>

    <nav class="topnav" aria-label="@L["Nav_Main"]">
        <NavLink href="" Match="NavLinkMatch.All">@L["Nav_Console"]</NavLink>
        <NavLink href="runs">@L["Nav_History"]</NavLink>
    </nav>

    <div class="topbar-end">
        <LanguageSwitch />
        <a class="source-link" href="https://github.com/MateoVH/AIAgentDemo" target="_blank" rel="noopener">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.71 1.23 1.87.87 2.33.67.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z" /></svg>
            <span>@L["Source"]</span>
        </a>
    </div>
</header>

<main id="main">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

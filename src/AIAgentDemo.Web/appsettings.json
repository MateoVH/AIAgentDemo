{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Agents.AI": "Warning",
      "Microsoft.Extensions.AI": "Warning"
    }
  },
  "AllowedHosts": "*",

  "AI": {
    // Auto: Claude if ANTHROPIC_API_KEY (or AI:Anthropic:ApiKey) is set, then OpenAI, then Azure OpenAI, otherwise Demo.
    // Or force one: Demo | Anthropic | OpenAI | AzureOpenAI | Ollama. Keep keys in user secrets, never in this file.
    "Provider": "Auto",
    "Anthropic": { "Model": "claude-opus-5-5", "SendReasoningEffort": true },
    "OpenAI": { "Model": "gpt-5-mini", "SendReasoningEffort": true },
    "AzureOpenAI": { "Endpoint": "", "Model": "gpt-5-mini", "SendReasoningEffort": true },
    "Ollama": { "Endpoint": "http://localhost:11434/v1", "Model": "qwen3:8b", "SendReasoningEffort": false },
    "Demo": { "LatencyMs": 650 },
    "MaxToolIterations": 6,

    // Per-agent overrides. Model routing is optional: e.g. a smaller model for triage and writing.
    "Agents": {
      "Classifier": { "MaxOutputTokens": 2048, "ReasoningEffort": "Low" },
      "DataAnalyst": { "MaxOutputTokens": 4096, "ReasoningEffort": "Low" },
      "Supervisor": { "MaxOutputTokens": 4096, "ReasoningEffort": "Medium" },
      "Writer": { "MaxOutputTokens": 2048, "ReasoningEffort": "Low" }
    }
  },

  "Budget": {
    "MaxCostPerRunUsd": 0.50,
    "MaxTokensPerRun": 200000
  },

  "Approval": {
    "RequiredFor": [ "issue_refund", "create_discount_coupon", "cancel_order" ],
    "TimeoutMinutes": 15
  },

  "Storage": {
    "DataDirectory": "App_Data",
    "ResetStoreOnStartup": true
  },

  // USD per 1M tokens. Longest prefix wins ("gpt-5-mini" also prices "gpt-5-mini-2025-08-07").
  // Prices change: check your provider's price list before relying on these numbers.
  "Pricing": {
    "Models": [
      { "Model": "demo-simulated", "InputPerMillion": 4.00, "OutputPerMillion": 20.00 },
      { "Model": "claude-opus-5-5", "InputPerMillion": 4.00, "OutputPerMillion": 20.00, "CachedInputPerMillion": 0.20 },
      { "Model": "claude-sonnet-5-5", "InputPerMillion": 2.00, "OutputPerMillion": 10.00, "CachedInputPerMillion": 0.20 },
      { "Model": "claude-haiku-5-5", "InputPerMillion": 0.10, "OutputPerMillion": 0.50 },
      { "Model": "gpt-5", "InputPerMillion": 1.25, "OutputPerMillion": 10.00, "CachedInputPerMillion": 0.125 },
      { "Model": "gpt-5-mini", "InputPerMillion": 0.25, "OutputPerMillion": 2.00, "CachedInputPerMillion": 0.025 },
      { "Model": "gpt-5-nano", "InputPerMillion": 0.05, "OutputPerMillion": 0.40, "CachedInputPerMillion": 0.005 },
      { "Model": "gpt-4.1-mini", "InputPerMillion": 0.40, "OutputPerMillion": 1.60 },
      { "Model": "gpt-4o-mini", "InputPerMillion": 0.15, "OutputPerMillion": 0.60 },
      { "Model": "qwen3", "InputPerMillion": 0, "OutputPerMillion": 0 },
      { "Model": "llama3", "InputPerMillion": 0, "OutputPerMillion": 0 }
    ]
  }
}
